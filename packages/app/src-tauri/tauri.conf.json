{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wave Exit",
  "version": "0.4.0",
  "identifier": "com.waveexit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5317",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Wave Exit", "width": 1180, "height": 820, "minWidth": 720, "minHeight": 560, "dragDropEnabled": true }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

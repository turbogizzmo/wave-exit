{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wave-exit-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@wave-exit/app"
      ],
      "port": 5317
    },
    {
      "name": "wave-exit-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5318",
        "--bind",
        "127.0.0.1",
        "--directory",
        "site"
      ],
      "port": 5318
    },
    {
      "name": "wave-exit-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5319",
        "--bind",
        "127.0.0.1",
        "--directory",
        "packages/app/dist"
      ],
      "port": 5319
    }
  ]
}
